---
import Layout from "../../layouts/Layout.astro";
import { sanityClient, imgSrc, imgSrcSet } from "../../lib/sanity";

const CARD_WIDTHS = [170, 340, 510, 700, 1000];
const CARD_SIZES = "(max-width: 768px) 90vw, 170px";

export const prerender = false;

const { slug } = Astro.params;

const galerie = await sanityClient.fetch(
  `
  *[_type == "galerie" && slug.current == $slug][0] {
    titreHomepage,
    titrePage,
    sousTitre,
    nom,
    intro,
    texte,
    "pdfUrl": pdf.asset->url,
    "cover": textimageCover,
    "coverLqip": textimageCover.asset->metadata.lqip,
    "sousGaleries": *[_type == "galerie" && parent._ref == ^._id] | order(ordre asc) {
      titreHomepage,
      nom,
      "slug": slug.current,
      images[] {
        titre,
        image,
        "lqip": image.asset->metadata.lqip,
        "w": image.asset->metadata.dimensions.width,
        "h": image.asset->metadata.dimensions.height
      }
    },
    images[] {
      titre,
      image,
      "lqip": image.asset->metadata.lqip,
      "w": image.asset->metadata.dimensions.width,
      "h": image.asset->metadata.dimensions.height
    }
  }
`,
  { slug },
);

if (!galerie) return Astro.redirect("/404");

const estCategorie = (galerie.sousGaleries?.length ?? 0) > 0;
const titre = galerie.titrePage || galerie.nom || galerie.titreHomepage;
const aTexte = !!galerie.texte;

// SEO : description et image de partage propres à la galerie
const metaDescription = (
  galerie.intro ||
  galerie.sousTitre ||
  galerie.texte ||
  `${titre} — photographies de Philippe Muraro.`
)
  .replace(/\s+/g, " ")
  .slice(0, 160)
  .trim();
const premiereImage =
  galerie.images?.[0]?.image ||
  galerie.sousGaleries?.[0]?.images?.[0]?.image;
const ogImage = premiereImage ? imgSrc(premiereImage, 1200) : undefined;
---

<Layout title={titre} description={metaDescription} image={ogImage}>
  <style>
    .retour {
      display: inline-block;
      margin-bottom: 2rem;
      font-size: 0.72rem;
      color: #555;
      text-decoration: none;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transition: color 0.2s;
    }
    .retour:hover { color: #d0d0d0; }

    .galerie-header { margin-bottom: 3rem; }

    h1 {
      font-family: var(--font-title);
      font-size: var(--size-title);
      font-weight: 300;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-title);
      margin-bottom: 0.9rem;
    }

    /* Texte à gauche, bouton PDF en face à droite, centrés verticalement */
    .header-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
      margin: -0.3rem 0 0;
    }

    /* Le texte occupe toute la largeur restante : ligne entière s'il n'y a
       pas de bouton PDF, espace disponible sinon. */
    .header-texte {
      flex: 1;
      min-width: 0;
    }
    .header-texte > *:last-child { margin-bottom: 0; }

    .sous-titre-page {
      font-family: var(--font-title);
      font-size: 18px;
      font-weight: 300;
      letter-spacing: 0.08em;
      color: var(--color-subtitle);
      line-height: 1.2;
      margin: 0 0 0.5rem;
    }

    .intro {
      font-family: var(--font-title);
      font-size: 18px;
      color: var(--color-subtitle);
      line-height: 1.4;
      font-weight: 300;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
      white-space: pre-line;
    }

    .pdf-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      flex-shrink: 0;
      margin-left: auto;
      /* Léger retrait pour ne pas dépasser du bord droit des vignettes */
      margin-right: 2.5rem;
      padding: 0.65rem 1.4rem;
      border: 1px solid #3a3a3a;
      color: #aaa;
      background: transparent;
      text-decoration: none;
      font-size: 0.76rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: color 0.2s, border-color 0.2s, background 0.2s;
    }
    .pdf-btn:hover {
      color: #e8e8e8;
      border-color: #777;
      background: rgba(255, 255, 255, 0.04);
    }
    .pdf-icon {
      font-size: 0.95rem;
      line-height: 1;
    }

    /* Variante placée sous le texte de la colonne de gauche.
       On réaffirme le style : sinon le bouton hérite de la serif du parent. */
    /* Vignette du textimage sur la page galerie */
    .textimage-bloc {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.7rem;
      margin-left: auto;
    }
    .textimage-cover {
      display: block;
      width: 170px;
      height: 170px;
      overflow: hidden;
    }
    .textimage-cover img {
      width: 170px;
      height: 170px;
      object-fit: cover;
      display: block;
      transition: opacity 0.3s;
    }
    .textimage-cover:hover img { opacity: 0.8; }
    .textimage-cover-colonne { margin: 1.5rem 0 0.8rem; }

    .pdf-btn-colonne {
      margin: 2rem 0 0;
      display: inline-flex;
      font-family: var(--font-body);
      font-size: 0.76rem;
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.14em;
    }

    /* Mise en page avec texte de gauche */
    .layout-texte {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 3rem;
      align-items: start;
    }
    .texte-gauche {
      font-family: var(--font-serif);
      font-size: 18px;
      line-height: 1.45;
      color: #a0a0a0;
      font-weight: 400;
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
    }
    /* Les retours à la ligne du texte sont conservés, mais pas ceux du template */
    .texte-corps { white-space: pre-line; }
    @media (max-width: 800px) {
      .layout-texte { grid-template-columns: 1fr; gap: 2rem; }
      .texte-gauche { position: static; }
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, 170px);
      gap: 1.25rem;
    }

    .grid figure { margin: 0; width: 170px; }
    .photo {
      display: block;
      width: 170px;
      height: 170px;
      padding: 0;
      border: 0;
      background: none;
      cursor: zoom-in;
      overflow: hidden;
    }
    .grid figure img {
      width: 100%;
      display: block;
      aspect-ratio: 1/1;
      object-fit: cover;
      filter: brightness(0.9);
      transition: opacity 0.3s, transform 0.4s ease;
    }
    .photo:hover img { opacity: 0.85; transform: scale(1.03); }

    figcaption {
      margin-top: 0.4rem;
      font-family: var(--font-title);
      font-size: 14px;
      color: #777;
      letter-spacing: 0.05em;
      font-weight: 300;
      text-align: center;
      width: 170px;
    }

    /* Sur mobile : grandes tuiles pleine largeur (placé APRÈS les règles de
       base pour gagner la cascade — sinon .photo{width:170px} l'emportait). */
    @media (max-width: 768px) {
      /* Une tuile centrée à ~82% de la largeur : plus grande qu'avant,
         mais pas pleine largeur, avec une marge modérée. */
      .grid { grid-template-columns: min(82vw, 360px); justify-content: center; gap: 0.8rem; }
      .grid figure { width: auto; }
      .photo { width: 100%; height: auto; aspect-ratio: 1/1; }
      figcaption { width: auto; }
    }

    /* Vue catégorie : sections par sous-galerie */
    .sous-galerie { margin-bottom: 3rem; scroll-margin-top: calc(var(--nav-height) + 1.5rem); }
    .grid figure { scroll-margin-top: calc(var(--nav-height) + 1.5rem); }
    .sous-galerie:last-child { margin-bottom: 0; }
    .sous-titre {
      font-family: var(--font-title);
      font-size: 18px;
      font-weight: 300;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-subtitle);
      line-height: 1.15;
      margin-bottom: 0.7rem;
    }

    /* ── Lightbox ── */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(10, 10, 10, 0.75);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease;
      backdrop-filter: blur(4px);
    }
    .lightbox.open { opacity: 1; visibility: visible; }

    .lb-stage {
      margin: 0;
      max-width: 92vw;
      max-height: 92vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }
    /* Nom du golf / de la sous-galerie, au-dessus de la photo */
    .lb-group {
      font-family: var(--font-title);
      font-size: 18px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #e8e8e8;
      text-align: center;
    }
    #lb-img {
      max-width: 92vw;
      max-height: 84vh;
      object-fit: contain;
      box-shadow: 0 10px 60px rgba(0, 0, 0, 0.6);
      transform: scale(0.97);
      opacity: 0;
      transition: transform 0.3s ease, opacity 0.5s ease;
    }
    .lightbox.open #lb-img { transform: scale(1); }
    /* Fondu au changement de photo */
    #lb-img.loaded { opacity: 1; }
    /* Masquage instantané (sans transition) avant le fondu d'apparition */
    #lb-img.instant { transition: none; }
    #lb-caption {
      color: #bbb;
      font-family: var(--font-title);
      font-size: 14px;
      letter-spacing: 0.06em;
      font-weight: 300;
      text-align: center;
      min-height: 1em;
    }

    /* Modale PDF */
    .pdf-stage {
      width: min(1100px, 92vw);
      height: 88vh;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    #pdf-frame {
      flex: 1;
      width: 100%;
      border: 0;
      background: #1a1a1a;
      box-shadow: 0 10px 60px rgba(0, 0, 0, 0.6);
    }
    .pdf-dl {
      align-self: center;
      font-family: var(--font-title);
      font-size: 14px;
      letter-spacing: 0.08em;
      color: #bbb;
      text-decoration: none;
      transition: color 0.2s;
    }
    .pdf-dl:hover { color: #fff; }

    .lb-close {
      position: fixed;
      top: 1.2rem;
      right: 1.6rem;
      font-size: 2.6rem;
      background: none;
      border: 0;
      color: #ddd;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s;
      user-select: none;
    }
    .lb-close:hover { color: #fff; }

    /* Le conteneur épouse la taille exacte de la photo affichée */
    .lb-img-wrap {
      position: relative;
      display: inline-block;
      line-height: 0;
    }
    /* Flèches collées juste à l'extérieur des bords de la photo */
    .lb-nav {
      position: absolute;
      top: 50%;
      background: none;
      border: 0;
      color: #fff;
      cursor: pointer;
      line-height: 1;
      font-size: 3rem;
      padding: 0.2rem 0.6rem;
      opacity: 0.8;
      user-select: none;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
      transition: opacity 0.2s;
    }
    .lb-nav:hover { opacity: 1; }
    .lb-prev { left: 0; transform: translate(-100%, -50%); }
    .lb-next { right: 0; transform: translate(100%, -50%); }

    /* Aperçu du golf suivant, label vertical stylisé à droite (desktop) */
    .lb-next-hint {
      position: fixed;
      right: 1.4rem;
      top: 50%;
      transform: translateY(-50%);
      writing-mode: vertical-rl;
      font-family: var(--font-title);
      font-size: 15px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #8f8f8f;
      max-height: 78vh;
      padding-top: 1.6rem;
      pointer-events: none;
    }
    /* Petit trait décoratif au-dessus du nom */
    .lb-next-hint::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      width: 1px;
      height: 1rem;
      background: #6a6a6a;
    }
    .lb-next-hint[hidden] { display: none !important; }
    /* Entrée en glissé depuis la droite, puis léger pouls pour capter l'œil */
    .lb-next-hint {
      animation: hint-in 0.45s cubic-bezier(0.2, 0.7, 0.3, 1) both,
        hint-pulse 2.4s ease-in-out 0.45s infinite;
    }
    @keyframes hint-in {
      from { opacity: 0; transform: translateY(-50%) translateX(16px); }
      to { opacity: 1; transform: translateY(-50%) translateX(0); }
    }
    @keyframes hint-pulse {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }
    @media (max-width: 900px) {
      .lb-next-hint { display: none !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lb-next-hint { animation: none; opacity: 0.85; }
      #lb-img { transition: none; }
    }

    /* Sur petit écran, la photo occupe presque toute la largeur : on repasse
       les flèches à l'intérieur des bords pour qu'elles restent visibles. */
    @media (max-width: 700px) {
      /* Portrait : flèches en HAUT et EN BAS (centrées) pour libérer les côtés
         et afficher la photo au plus grand. Le chevron est tourné à 90°. */
      .lb-nav {
        position: fixed;
        left: 50%;
        right: auto;
        top: auto;
        font-size: 2.6rem;
        transform: translateX(-50%) rotate(90deg);
      }
      .lb-prev { top: 0.4rem; }
      .lb-next { bottom: 0.4rem; }
      .lb-close { font-size: 2rem; }
      /* Boîte fixe + object-fit:contain : la photo remplit l'espace au maximum
         (98vw × 86vh) sans déformation, quelle que soit sa résolution.
         max-width/height étaient de simples plafonds, l'image restait petite. */
      .lb-stage { max-width: 100vw; gap: 0.3rem; }
      /* L'élément épouse la photo (pas de boîte fixe → pas de bande vide) */
      .lb-img-wrap { display: block; width: 100%; text-align: center; }
      #lb-img { width: auto; height: auto; max-width: 94vw; max-height: 86vh; }
      #lb-caption { display: none; } /* on masque la légende pour maximiser la photo */
    }

    /* Écrans bas de plafond (téléphone en paysage) : on maximise la photo
       et on réduit le décor vertical (nom du golf, légende, marges). */
    @media (max-height: 560px) {
      .lb-stage { gap: 0.2rem; max-height: 100vh; max-width: 100vw; }
      /* L'élément épouse la photo (pas de boîte fixe → pas de bande vide) */
      .lb-img-wrap { display: block; width: 100%; text-align: center; }
      #lb-img { width: auto; height: auto; max-width: 96vw; max-height: 92vh; }
      /* Flèches fixées aux bords de l'écran (la photo occupe presque tout) */
      .lb-nav {
        position: fixed;
        top: 50%;
        left: auto;
        right: auto;
        font-size: 2.2rem;
        transform: translateY(-50%);
      }
      .lb-prev { left: 0.2rem; }
      .lb-next { right: 0.2rem; }
      .lb-group { font-size: 11px; }
      #lb-caption { display: none; } /* on masque la légende en paysage pour agrandir la photo */
      .lb-close { top: 0.4rem; right: 0.6rem; font-size: 1.6rem; }
    }
  </style>

  <a href="/galeries" class="retour">← Galeries</a>

  <div class="galerie-header">
    <h1>{titre}</h1>
    {/* Texte à gauche (sous-titre + description), bouton PDF en face à droite */}
    <div class="header-meta">
      <div class="header-texte">
        {galerie.sousTitre && <p class="sous-titre-page">{galerie.sousTitre}</p>}
        {/* La description n'apparaît que sur la page de la galerie elle-même */}
        {galerie.intro && <p class="intro">{galerie.intro}</p>}
      </div>
      {/* Sans texte de colonne, bouton (+ vignette textimage) dans l'en-tête.
          Avec texte, ils sont placés sous celui-ci (colonne de gauche). */}
      {galerie.pdfUrl && !aTexte && (
        <div class="textimage-bloc">
          {galerie.cover && (
            <a href={galerie.pdfUrl} target="_blank" rel="noopener" class="textimage-cover" aria-label="Ouvrir le textimage">
              <img
                src={imgSrc(galerie.cover, 340, { square: true })}
                srcset={imgSrcSet(galerie.cover, [170, 340, 510], { square: true })}
                sizes="170px"
                alt={`Textimage — ${titre}`}
                loading="lazy"
                decoding="async"
                style={galerie.coverLqip ? `background-image:url(${galerie.coverLqip});background-size:cover` : undefined}
              />
            </a>
          )}
          <a href={galerie.pdfUrl} target="_blank" rel="noopener" class="pdf-btn" id="pdf-open">
            <span class="pdf-icon">↓</span> Ouvrir le textimage (PDF)
          </a>
        </div>
      )}
    </div>
  </div>

  {estCategorie ? (
    /* Catégorie : toutes les photos des sous-galeries, regroupées sous un intertitre */
    <div class="sections">
      {galerie.sousGaleries.map((sg: any) => (
        <section class="sous-galerie">
          <h2 class="sous-titre">{sg.nom || sg.titreHomepage}</h2>
          <div class="grid">
            {sg.images?.map((item: any) => (
              <figure>
                <button
                  type="button"
                  class="photo"
                  data-full={imgSrc(item.image, 2000, { quality: 90 })}
                  data-w={item.w}
                  data-h={item.h}
                  data-caption={item.titre || ''}
                  data-group={sg.nom || sg.titreHomepage}
                >
                  <img
                    src={imgSrc(item.image, 340, { square: true })}
                    srcset={imgSrcSet(item.image, CARD_WIDTHS, { square: true })}
                    sizes={CARD_SIZES}
                    alt={item.titre || sg.nom || sg.titreHomepage}
                    loading="lazy"
                    decoding="async"
                    style={item.lqip ? `background-image:url(${item.lqip});background-size:cover;background-position:center` : undefined}
                  />
                </button>
                {item.titre && <figcaption>{item.titre}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>
  ) : aTexte ? (
    <div class="layout-texte">
      <aside class="texte-gauche">
        <div class="texte-corps">{galerie.texte}</div>
        {galerie.pdfUrl && galerie.cover && (
          <a href={galerie.pdfUrl} target="_blank" rel="noopener" class="textimage-cover textimage-cover-colonne" aria-label="Ouvrir le textimage">
            <img
              src={imgSrc(galerie.cover, 340, { square: true })}
              srcset={imgSrcSet(galerie.cover, [170, 340, 510], { square: true })}
              sizes="170px"
              alt={`Textimage — ${titre}`}
              loading="lazy"
              decoding="async"
              style={galerie.coverLqip ? `background-image:url(${galerie.coverLqip});background-size:cover` : undefined}
            />
          </a>
        )}
        {galerie.pdfUrl && (
          <a href={galerie.pdfUrl} target="_blank" rel="noopener" class="pdf-btn pdf-btn-colonne" id="pdf-open">
            <span class="pdf-icon">↓</span> Ouvrir le textimage (PDF)
          </a>
        )}
      </aside>
      <div class="grid">
        {galerie.images?.map((item: any) => (
          <figure>
            <button
              type="button"
              class="photo"
              data-full={imgSrc(item.image, 2000, { quality: 90 })}
              data-w={item.w}
              data-h={item.h}
              data-caption={item.titre || ''}
            >
              <img
                src={imgSrc(item.image, 340, { square: true })}
                srcset={imgSrcSet(item.image, CARD_WIDTHS, { square: true })}
                sizes={CARD_SIZES}
                alt={item.titre || titre}
                loading="lazy"
                decoding="async"
                style={item.lqip ? `background-image:url(${item.lqip});background-size:cover;background-position:center` : undefined}
              />
            </button>
            {item.titre && <figcaption>{item.titre}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  ) : (
    <div class="grid">
      {galerie.images?.map((item: any) => (
        <figure>
          <button
            type="button"
            class="photo"
            data-full={imgSrc(item.image, 2000, { quality: 90 })}
            data-w={item.w}
            data-h={item.h}
            data-caption={item.titre || ''}
          >
            <img
              src={imgSrc(item.image, 340, { square: true })}
              srcset={imgSrcSet(item.image, CARD_WIDTHS, { square: true })}
              sizes={CARD_SIZES}
              alt={item.titre || titre}
              loading="lazy"
              decoding="async"
              style={item.lqip ? `background-image:url(${item.lqip});background-size:cover;background-position:center` : undefined}
            />
          </button>
          {item.titre && <figcaption>{item.titre}</figcaption>}
        </figure>
      ))}
    </div>
  )}

  {/* ── Lightbox / modale plein écran ── */}
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button class="lb-close" aria-label="Fermer">×</button>
    <div id="lb-next-hint" class="lb-next-hint" hidden></div>
    <figure class="lb-stage">
      <div id="lb-group" class="lb-group" hidden></div>
      <div class="lb-img-wrap">
        <button class="lb-nav lb-prev" aria-label="Précédent">‹</button>
        <img id="lb-img" src="" alt="" />
        <button class="lb-nav lb-next" aria-label="Suivant">›</button>
      </div>
      <figcaption id="lb-caption"></figcaption>
    </figure>
  </div>

  {/* ── Modale PDF (desktop uniquement) ── */}
  {galerie.pdfUrl && (
    <div id="pdf-modal" class="lightbox" aria-hidden="true">
      <button class="lb-close" id="pdf-close" aria-label="Fermer">×</button>
      <div class="pdf-stage">
        <iframe id="pdf-frame" title="Textimage (PDF)" src=""></iframe>
        <a href={galerie.pdfUrl} target="_blank" rel="noopener" class="pdf-dl">
          Ouvrir dans un nouvel onglet ↗
        </a>
      </div>
    </div>
  )}

  <script>
    const lb = document.getElementById('lightbox') as HTMLElement;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbCap = document.getElementById('lb-caption') as HTMLElement;
    const lbGroup = document.getElementById('lb-group') as HTMLElement;
    const lbNextHint = document.getElementById('lb-next-hint') as HTMLElement;
    const photos = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo'));
    let index = -1;

    function preload(i: number) {
      const btn = photos[i];
      if (!btn) return;
      const img = new Image();
      img.src = btn.dataset.full || '';
    }

    // Précharge une fenêtre autour de la photo courante (et pas toute la
    // galerie : sur « Des golfs » cela évitait de télécharger ~85 images).
    function preloadWindow(i: number) {
      for (let d = 1; d <= 3; d++) {
        preload((i + d) % photos.length);
        preload((i - d + photos.length) % photos.length);
      }
    }

    function show(i: number) {
      if (i < 0) i = photos.length - 1;
      if (i >= photos.length) i = 0;
      index = i;
      const btn = photos[i];
      // Fondu : masquage INSTANTANÉ (sans transition), puis fondu d'apparition
      // de la nouvelle image une fois chargée.
      lbImg.classList.add('instant');   // désactive la transition
      lbImg.classList.remove('loaded'); // opacité 0 immédiate
      void lbImg.offsetWidth;           // on peint l'état masqué
      lbImg.classList.remove('instant'); // réactive la transition pour le fondu
      const reveal = () => lbImg.classList.add('loaded');
      lbImg.onload = reveal;
      // Pas de srcset ici : on charge directement l'image 2000px pour que
      // l'élément épouse exactement la photo (via max-width/height), sans bande.
      lbImg.removeAttribute('srcset');
      lbImg.removeAttribute('sizes');
      // Ne jamais agrandir au-delà de la taille réelle de la photo (sinon flou) :
      // largeur/hauteur affichées = min(écran, dimensions natives).
      const nw = btn.dataset.w, nh = btn.dataset.h;
      lbImg.style.maxWidth = nw ? `min(94vw, ${nw}px)` : '';
      lbImg.style.maxHeight = nh ? `min(90vh, ${nh}px)` : '';
      lbImg.src = btn.dataset.full || '';
      if (lbImg.complete) requestAnimationFrame(reveal); // déjà en cache
      const cap = btn.dataset.caption || '';
      lbImg.alt = cap;
      lbCap.textContent = cap;
      // Nom du golf / sous-galerie au-dessus de la photo
      const group = btn.dataset.group || '';
      lbGroup.textContent = group;
      lbGroup.hidden = !group;
      // Aperçu du golf suivant, uniquement si on va changer de golf
      const next = photos[i + 1 >= photos.length ? 0 : i + 1];
      const nextGroup = next?.dataset.group || '';
      if (nextGroup && nextGroup !== group) {
        lbNextHint.textContent = nextGroup;
        lbNextHint.hidden = false;
        // Relance l'animation d'entrée à chaque apparition
        lbNextHint.style.animation = 'none';
        void lbNextHint.offsetHeight;
        lbNextHint.style.animation = '';
      } else {
        lbNextHint.hidden = true;
      }
      // précharge les voisines pour une navigation instantanée
      preloadWindow(i);
    }

    function open(i: number) {
      show(i);
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Recentre la page sur la dernière photo vue (et donc son golf)
      const btn = photos[index];
      if (btn) {
        const cible = btn.closest('.sous-galerie') || btn.closest('figure') || btn;
        cible.scrollIntoView({ block: 'start' });
      }
    }

    photos.forEach((btn, i) => btn.addEventListener('click', () => open(i)));

    lb.querySelector('.lb-close')!.addEventListener('click', close);
    lb.querySelector('.lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); show(index - 1); });
    lb.querySelector('.lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); show(index + 1); });

    // Le clic tombe-t-il sur les pixels réellement affichés de la photo ?
    // (avec object-fit:contain, l'élément img inclut des bandes vides autour.)
    function clicSurLaPhoto(e: MouseEvent) {
      const r = lbImg.getBoundingClientRect();
      const nW = lbImg.naturalWidth, nH = lbImg.naturalHeight;
      if (!nW || !nH) return true;
      const scale = Math.min(r.width / nW, r.height / nH);
      const dW = nW * scale, dH = nH * scale;
      const x0 = r.left + (r.width - dW) / 2;
      const y0 = r.top + (r.height - dH) / 2;
      return e.clientX >= x0 && e.clientX <= x0 + dW && e.clientY >= y0 && e.clientY <= y0 + dH;
    }

    // Clic hors de la photo (fond OU bandes vides autour) ferme ; flèches exclues
    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.lb-nav')) return;                 // flèche : changer de photo
      if (t === lbImg && clicSurLaPhoto(e)) return;     // sur la photo visible : ne rien faire
      close();                                          // partout ailleurs : fermer
    });

    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });

    // ── Swipe tactile (mobile) : gauche/droite = changer de photo, bas = fermer
    let tsX = 0, tsY = 0, tsT = 0;
    lb.addEventListener('touchstart', (e) => {
      const t = e.changedTouches[0];
      tsX = t.clientX; tsY = t.clientY; tsT = Date.now();
    }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - tsX, dy = t.clientY - tsY;
      const ax = Math.abs(dx), ay = Math.abs(dy);
      if (Date.now() - tsT > 700) return;      // trop lent = pas un swipe
      if (ax < 45 && ay < 45) return;          // trop court = pas un swipe
      if (ax >= ay) show(dx < 0 ? index + 1 : index - 1); // horizontal : gauche = suivante
      else show(dy < 0 ? index + 1 : index - 1);          // vertical : haut = suivante
    }, { passive: true });

    // ── Modale PDF (desktop uniquement) ─────────────────────────────────
    // Sur mobile les navigateurs ne rendent pas les PDF en iframe : on laisse
    // le lien s'ouvrir normalement dans un nouvel onglet.
    const pdfBtn = document.getElementById('pdf-open') as HTMLAnchorElement | null;
    const pdfModal = document.getElementById('pdf-modal');
    const pdfFrame = document.getElementById('pdf-frame') as HTMLIFrameElement | null;

    if (pdfBtn && pdfModal && pdfFrame) {
      const surMobile = () =>
        window.matchMedia('(max-width: 900px)').matches ||
        window.matchMedia('(pointer: coarse)').matches;

      const fermerPdf = () => {
        pdfModal.classList.remove('open');
        pdfModal.setAttribute('aria-hidden', 'true');
        pdfFrame.src = ''; // libère le lecteur PDF
        document.body.style.overflow = '';
      };

      pdfBtn.addEventListener('click', (e) => {
        if (surMobile()) return; // comportement natif : nouvel onglet
        e.preventDefault();
        pdfFrame.src = pdfBtn.href;
        pdfModal.classList.add('open');
        pdfModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      document.getElementById('pdf-close')?.addEventListener('click', fermerPdf);
      pdfModal.addEventListener('click', (e) => { if (e.target === pdfModal) fermerPdf(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && pdfModal.classList.contains('open')) fermerPdf();
      });
    }
  </script>
</Layout>
